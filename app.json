{
  "expo": {
    "name": "UniMeal Cafe",
    "slug": "unimeal-cafe-app",
    "version": "3.0.4",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "unimeal-cafe",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "extra": {
      "API_URL": "https://unimeal-backend.duckdns.org",
      "router": {},
      "eas": {
        "projectId": "5f7f407b-a650-4545-961a-91b704f8f4cf"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unimeal.cafe"
    },
    "android": {
      "package": "com.unimeal.cafe",
      "minSdkVersion": 24,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FF6B35"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF6B35"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow UniMeal Cafe to save QR codes to your photo library.",
          "savePhotosPermission": "Allow UniMeal Cafe to save QR codes to your photo library.",
          "isAccessMediaLocationEnabled": true,
          "isAudioEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "kotlinVersion": "2.1.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "samri44"
  }
}
