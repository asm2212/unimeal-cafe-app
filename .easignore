# EAS Build ignore file
# Exclude unnecessary files to reduce build size

# Development files
.git/
.github/
.expo/
.next/
dist/
build-output/

# Android build artifacts (these take up most space)
**/android/build/
**/android/.cxx/
**/.cxx/
**/build/intermediates/
**/build/outputs/
android/app/.cxx/

# Node modules build artifacts
node_modules/**/android/build/
node_modules/**/.cxx/
node_modules/**/build/intermediates/

# Documentation and scripts
*.md
*.txt
scripts/
docs/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env.local
.env.development.local
.env.test.local
.env.production.local

# Temporary folders
tmp/
temp/

# Build artifacts
*.apk
*.aab
*.ipa

# Large media files (if any)
*.mp4
*.mov
*.avi
*.mkv

# Backup files
*.bak
*.backup

# Additional build optimizations
# Test files
**/__tests__/
**/*.test.js
**/*.test.ts
**/*.test.tsx
**/*.spec.js
**/*.spec.ts
**/*.spec.tsx

# Source maps and debug files
**/*.map
**/*.debug.js

# Large binary files in node_modules
node_modules/**/bin/
node_modules/**/sdks/
node_modules/**/*.so
node_modules/**/*.dll
node_modules/**/*.dylib

# Documentation in node_modules
node_modules/**/README.md
node_modules/**/CHANGELOG.md
node_modules/**/LICENSE
node_modules/**/docs/
node_modules/**/examples/

# Unnecessary platform files
node_modules/**/ios/
node_modules/**/windows/
node_modules/**/macos/
